{
  "graph": {
    "reader": {
      "label": "Reader",
      "type": "structure-reader"
    },
    "symmetry": {
      "label": "Symmetries",
      "type": "compute-symmetries",
      "in": "reader"
    },
    "unit": {
      "label": "Unit Cell",
      "type": "draw-unit-cell",
      "in": "symmetry"
    },
    "bonds": {
      "label": "Bonds",
      "type": "compute-bonds",
      "in": "unit"
    },
    "draw": {
      "label": "Draw structure",
      "type": "draw-structure",
      "in": "slice"
    },
    "matchers": {
      "label": "Find similar structures",
      "type": "find-similar",
      "in": "symmetry"
    },
    "slice": {
      "label": "Slicer",
      "type": "slice-structure",
      "in": "bonds"
    },
    "backbone": {
      "label": "Backbone",
      "type": "structure-backbone",
      "in": "symmetry"
    },
    "cfp": {
      "label": "Fingerprints",
      "type": "compute-fingerprints",
      "in": "reader"
    },
    "sets": {
      "label": "Analyze structure sets",
      "type": "analyze-structure-sets",
      "in": "reader"
    },
    "polyhedra": {
      "label": "Polyhedra",
      "type": "draw-polyhedra",
      "in": "bonds"
    },
    "shape": {
      "label": "Crystal shape",
      "type": "compute-crystal-shape",
      "in": "bonds"
    },
    "smooth": {
      "label": "Interpolate volume",
      "type": "interpolate-volume",
      "in": "unit"
    },
    "ortho": {
      "label": "Orthoslice",
      "type": "orthoslice",
      "in": "smooth"
    },
    "iso": {
      "label": "Isosurface",
      "type": "isosurface",
      "in": "smooth"
    },
    "trace": {
      "label": "Trajectories",
      "type": "draw-trajectories",
      "in": "bonds"
    },
    "xray": {
      "label": "X-Ray diffraction",
      "type": "diffraction-pattern",
      "in": "symmetry"
    },
    "measure": {
      "label": "Measures",
      "type": "measures",
      "in": "bonds"
    },
    "writer": {
      "label": "Writer",
      "type": "structure-writer",
      "in": "bonds"
    },
    "capture": {
      "label": "Capture media",
      "type": "capture-view"
    },
    "viewer": {
      "label": "Viewer",
      "type": "viewer-3d"
    }
  },
